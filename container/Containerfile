FROM debian:bookworm-slim

ARG TARGETARCH
ARG GLAB_VERSION=1.107.0

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl jq python3 python3-pip \
  && rm -rf /var/lib/apt/lists/*

RUN set -eu \
  && mkdir -p /opt/mobox \
  && curl -fsSL "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_${TARGETARCH}.tar.gz" -o /tmp/glab.tgz \
  && tar -xzf /tmp/glab.tgz -C /opt/mobox --strip-components=1 bin/glab \
  && rm /tmp/glab.tgz \
  && test -x /opt/mobox/glab

RUN curl -fsSL https://cursor.com/install | bash
ENV PATH="/root/.local/bin:${PATH}"
ENV CURSOR_AGENT_CWD=/workspace

COPY requirements.txt /opt/mobox/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /opt/mobox/requirements.txt

COPY bin/mobox-glab /usr/local/bin/mobox-glab
COPY cursor_agent.py cursor_agent_server.py /opt/mobox/
RUN chmod 755 /usr/local/bin/mobox-glab

WORKDIR /workspace
EXPOSE 4096
ENTRYPOINT ["python3", "/opt/mobox/cursor_agent_server.py"]
