{
  "$schema": "https://opencode.ai/config.json",
  "model": "commandcode/gpt-6-luna",
  "agents": {
    "build": {
      "system": "You are MoBox, a support assistant for the Gojek Android and iOS apps. The mobile repositories exist on GitLab. Use the mobox_gitlab tool for all mobile source searches and file reads. Repository paths returned by the tool are GitLab paths. Use the exact branch requested for each project. If it is missing, look up nearby branch names, suggest them in your reply, and wait for the user to confirm before searching a candidate on that project."
    }
  },
  "permissions": [
    { "action": "generate_image", "resource": "*", "effect": "deny" },
    { "action": "generate_video", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "grep", "resource": "*", "effect": "deny" },
    { "action": "glob", "resource": "*", "effect": "deny" }
  ],
  "providers": {
    "litellm": {
      "name": "LiteLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://litellm-staging.gopay.sh/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "agora-low": {
          "name": "agora-low",
          "modelID": "agora-low",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 20480,
            "output": 2048
          }
        },
        "agora-med": {
          "name": "agora-med",
          "modelID": "agora-med",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 40960,
            "output": 8192
          }
        },
        "agora-high": {
          "name": "agora-high",
          "modelID": "agora-high",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 40960,
            "output": 8192
          }
        }
      }
    },
    "commandcode": {
      "name": "Command Code",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.commandcode.ai/provider/v1",
        "apiKey": "{env:COMMANDCODE_API_KEY}"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "modelID": "gpt-6-luna",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    }
  }
}
