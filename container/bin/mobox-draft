#!/usr/bin/env bash
# ponytail: token rides in git http.extraHeader. Process list can see it. Upgrade path is a git credential helper.
set -euo pipefail

if [[ "${1:-}" != "--confirm" ]]; then
  echo "needs confirmation" >&2
  exit 2
fi
shift

project_key="${1:-}"
source_branch="${2:-}"
issue="${3:-}"
diff_file="${4:-}"

case "${project_key}" in
  gohost) project="${GOHOST_PROJECT:-mobile/GoHost}" ;;
  ios) project="${IOS_PROJECT:-mobile/consumer-ios}" ;;
  *) echo "bad project" >&2; exit 2 ;;
esac

if [[ ! "${issue}" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "bad issue" >&2
  exit 2
fi
if [[ ! "${source_branch}" =~ ^[A-Za-z0-9._/-]+$ ]]; then
  echo "bad branch" >&2
  exit 2
fi
if [[ ! -f "${diff_file}" ]]; then
  echo "missing diff" >&2
  exit 2
fi
if [[ -z "${GITLAB_HOST:-}" || -z "${GITLAB_TOKEN:-}" ]]; then
  echo "GITLAB_HOST and GITLAB_TOKEN are required" >&2
  exit 2
fi

desc_file="${5:-}"
assignee="${6:-}"
if [[ -n "${desc_file}" && -f "${desc_file}" ]]; then
  desc="$(cat "${desc_file}")"
else
  desc="generated by bot, needs review"
fi

mr_title=""
if [[ -f "${desc_file}" ]]; then
  mr_title="$(grep -E '^\*\*(Change|Issue):\*\*' "${desc_file}" | head -1 | sed -E 's/^\*\*(Change|Issue):\*\*[[:space:]]*//' || true)"
  mr_title="${mr_title//\`/}"
fi

git="${MOBOX_GIT:-git}"
glab="${MOBOX_GLAB_BIN:-glab}"
prefix="fix"
if [[ -f "${desc_file}" ]] && grep -qE '^\*\*Change:\*\*' "${desc_file}"; then
  prefix="change"
fi
git_branch="mobox/${prefix}-${issue}"
mr_title="${mr_title:-${git_branch}}"
mr_title="${mr_title:0:200}"
root="${MOBOX_WORK:-/tmp}/mobox-${issue}"
rm -rf "${root}"
url="https://${GITLAB_HOST}/${project}.git"
header="http.extraHeader=PRIVATE-TOKEN: ${GITLAB_TOKEN}"

"${git}" -c "${header}" clone --depth 1 --branch "${source_branch}" "${url}" "${root}"
"${git}" -C "${root}" apply --recount --check "${diff_file}"
"${git}" -C "${root}" apply --recount "${diff_file}"
"${git}" -C "${root}" checkout -b "${git_branch}"
"${git}" -C "${root}" add -A
"${git}" -C "${root}" -c "user.email=${MOBOX_GIT_EMAIL:-mobox@local}" -c "user.name=${MOBOX_GIT_NAME:-mobox}" commit -m "${git_branch}"
"${git}" -C "${root}" -c "${header}" push -u origin "HEAD:${git_branch}"
create_args=(
  mr create --draft --yes
  -R "${project}"
  -s "${git_branch}"
  -b "${source_branch}"
  -t "${mr_title}"
  -d "${desc}"
)
if [[ -n "${assignee}" && ! "${assignee}" =~ ^ou_ && "${assignee}" =~ ^[A-Za-z0-9._-]+$ ]]; then
  create_args+=(-a "${assignee}")
fi
# glab compares GITLAB_HOST with the current checkout's remote. The bridge cwd is the MoBox repo (github.com).
( cd "${root}" && "${glab}" "${create_args[@]}" )
