#!/usr/bin/env bash
# Read-only GitLab access for mobile/GoHost and mobile/consumer-ios.
set -euo pipefail

GLAB="${MOBOX_GLAB:-/opt/mobox/glab}"

usage() {
  echo "usage: mobox-glab search <gohost|ios> <branch> <term>" >&2
  echo "       mobox-glab branches <gohost|ios> <partial-branch>" >&2
  echo "       mobox-glab file <gohost|ios> <branch> <path>" >&2
  echo "       mobox-glab mrs <gohost|ios> <opened|merged|closed|all>" >&2
  echo "       mobox-glab mr <gohost|ios> <iid>" >&2
  echo "       mobox-glab diff <gohost|ios> <iid>" >&2
  echo "       mobox-glab pipelines <gohost|ios> <branch>" >&2
  echo "       mobox-glab trace <gohost|ios> <job_id>" >&2
  echo "       mobox-glab issues <gohost|ios> [label]" >&2
  echo "       mobox-glab commits <gohost|ios> <branch> <path>" >&2
  echo "       mobox-glab crash <gohost|ios>" >&2
  exit 2
}

enc() {
  printf '%s' "$1" | jq -sRr @uri
}

require_project() {
  case "$1" in
    gohost) PROJECT="${GOHOST_PROJECT:?GOHOST_PROJECT is unset}" ;;
    ios) PROJECT="${IOS_PROJECT:?IOS_PROJECT is unset}" ;;
    *)
      echo "unknown project: $1" >&2
      return 2
      ;;
  esac
}

reject_sha() {
  if [[ "$1" =~ ^[0-9a-fA-F]{40}$ ]]; then
    echo "ref must be a branch name, not a commit SHA: $1" >&2
    exit 2
  fi
}

need_gitlab() {
  : "${GITLAB_HOST:?GITLAB_HOST is unset}"
  : "${GITLAB_TOKEN:?GITLAB_TOKEN is unset}"
}

branch_exists() {
  local error
  if ! error="$("$GLAB" api --hostname "$GITLAB_HOST" \
    "projects/${1}/repository/branches/${2}" 2>&1 >/dev/null)"
  then
    printf '%s\n' "$error" >&2
    if [[ "$error" == *"HTTP 404"* ]]; then
      echo "branch not found on ${3}: ${4}" >&2
    else
      echo "could not verify branch on ${3}: ${4}" >&2
    fi
    exit 1
  fi
}

api() {
  "$GLAB" api --hostname "$GITLAB_HOST" "$1"
}

[[ $# -ge 1 ]] || usage
cmd="$1"
shift

if [[ "$cmd" == "crash" ]]; then
  [[ $# -eq 1 ]] || usage
  require_project "$1"
  echo "crash data unavailable"
  exit 0
fi

need_gitlab

case "$cmd" in
  search)
    [[ $# -ge 3 ]] || usage
    which="$1"
    branch="$2"
    shift 2
    term="$*"
    [[ -n "$term" ]] || usage
    reject_sha "$branch"
    require_project "$which"
    project_enc="$(enc "$PROJECT")"
    branch_enc="$(enc "$branch")"
    branch_exists "$project_enc" "$branch_enc" "$PROJECT" "$branch"
    api "projects/${project_enc}/search?scope=blobs&search=$(enc "$term")&ref=${branch_enc}&per_page=20"
    ;;
  branches)
    [[ $# -eq 2 && -n "$2" ]] || usage
    require_project "$1"
    project_enc="$(enc "$PROJECT")"
    api "projects/${project_enc}/repository/branches?search=$(enc "$2")&per_page=20" | jq -r '.[].name'
    ;;
  file)
    [[ $# -eq 3 ]] || usage
    which="$1"
    branch="$2"
    filepath="$3"
    reject_sha "$branch"
    require_project "$which"
    project_enc="$(enc "$PROJECT")"
    branch_enc="$(enc "$branch")"
    branch_exists "$project_enc" "$branch_enc" "$PROJECT" "$branch"
    api "projects/${project_enc}/repository/files/$(enc "$filepath")/raw?ref=${branch_enc}"
    ;;
  mrs)
    [[ $# -eq 2 ]] || usage
    which="$1"
    state="$2"
    case "$state" in
      opened | merged | closed | all) ;;
      *)
        echo "bad state: $state" >&2
        exit 2
        ;;
    esac
    require_project "$which"
    project_enc="$(enc "$PROJECT")"
    api "projects/${project_enc}/merge_requests?state=${state}&per_page=20"
    ;;
  mr)
    [[ $# -eq 2 ]] || usage
    which="$1"
    iid="$2"
    [[ "$iid" =~ ^[0-9]+$ ]] || {
      echo "bad iid: $iid" >&2
      exit 2
    }
    require_project "$which"
    project_enc="$(enc "$PROJECT")"
    api "projects/${project_enc}/merge_requests/${iid}"
    ;;
  diff)
    [[ $# -eq 2 ]] || usage
    which="$1"
    iid="$2"
    [[ "$iid" =~ ^[0-9]+$ ]] || {
      echo "bad iid: $iid" >&2
      exit 2
    }
    require_project "$which"
    project_enc="$(enc "$PROJECT")"
    api "projects/${project_enc}/merge_requests/${iid}/diffs?per_page=20" | head -c 4000
    printf '\n'
    ;;
  pipelines)
    [[ $# -eq 2 ]] || usage
    which="$1"
    branch="$2"
    reject_sha "$branch"
    require_project "$which"
    project_enc="$(enc "$PROJECT")"
    branch_enc="$(enc "$branch")"
    branch_exists "$project_enc" "$branch_enc" "$PROJECT" "$branch"
    api "projects/${project_enc}/pipelines?ref=${branch_enc}&per_page=5"
    ;;
  trace)
    [[ $# -eq 2 ]] || usage
    which="$1"
    job="$2"
    [[ "$job" =~ ^[0-9]+$ ]] || {
      echo "bad job: $job" >&2
      exit 2
    }
    require_project "$which"
    project_enc="$(enc "$PROJECT")"
    api "projects/${project_enc}/jobs/${job}/trace" | tail -n 80
    ;;
  issues)
    [[ $# -eq 1 || $# -eq 2 ]] || usage
    which="$1"
    require_project "$which"
    project_enc="$(enc "$PROJECT")"
    path="projects/${project_enc}/issues?state=opened&per_page=20"
    if [[ $# -eq 2 ]]; then
      [[ "$2" =~ ^[A-Za-z0-9_.-]+$ ]] || {
        echo "bad label: $2" >&2
        exit 2
      }
      path="${path}&labels=$(enc "$2")"
    fi
    api "$path"
    ;;
  commits)
    [[ $# -eq 3 ]] || usage
    which="$1"
    branch="$2"
    filepath="$3"
    reject_sha "$branch"
    require_project "$which"
    project_enc="$(enc "$PROJECT")"
    branch_enc="$(enc "$branch")"
    branch_exists "$project_enc" "$branch_enc" "$PROJECT" "$branch"
    api "projects/${project_enc}/repository/commits?ref=${branch_enc}&path=$(enc "$filepath")&per_page=10"
    ;;
  *)
    usage
    ;;
esac
